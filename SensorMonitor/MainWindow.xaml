<Window
    x:Class="SensorMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ei="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:SensorMonitor.ViewModels"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    xmlns:oxy="http://oxyplot.org/wpf"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    Title="Sensor Monitor"
    Width="1280"
    Height="720"
    MinWidth="900"
    MinHeight="550"
    ui:WindowHelper.UseModernWindowStyle="True"
    WindowState="Maximized">

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <ei:CallMethodAction MethodName="OnWindowClosing" TargetObject="{Binding}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Window.Resources>
        <Style x:Key="HeaderTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF007ACC" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <local:NotConverter x:Key="Not" />
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <StatusBar Height="24" DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding ConnectionStatusText}" />
            </StatusBarItem>
        </StatusBar>

        <TabControl>
            <TabItem Width="130">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon
                            Height="24"
                            Animation="Spin"
                            Foreground="DarkGreen"
                            Kind="HomeAlertOutline" />
                        <TextBlock Margin="6,0,0,0" Text="Start" />
                    </StackPanel>
                </TabItem.Header>



                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <!--  Górny: maksymalna dostępna wysokość  -->
                        <RowDefinition Height="*" MinHeight="80" />
                        <!--  Środkowy: 60  -->
                        <RowDefinition Height="70" />
                        <!--  Dolny: 60  -->
                    </Grid.RowDefinitions>


                    <ui:SimpleStackPanel
                        Grid.Row="2"
                        Height="70"
                        MinHeight="70"
                        DockPanel.Dock="Bottom"
                        Orientation="Horizontal">

                        <Button
                            Width="120"
                            Height="50"
                            Margin="20,0,0,0"
                            Background="LightGreen"
                            Command="{Binding ClickStartCommand}"
                            IsEnabled="{Binding StartButtonEnabled}">
                            <ui:SimpleStackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon
                                    Height="20"
                                    Animation="Spin"
                                    Foreground="DarkGreen"
                                    Kind="StopwatchStart" />
                                <TextBlock Margin="6,0,0,0" Text="Start" />
                            </ui:SimpleStackPanel>
                        </Button>

                        <Button
                            Width="120"
                            Height="50"
                            Margin="20,0,0,0"
                            Background="PaleVioletRed"
                            Command="{Binding ClickStopCommand}"
                            IsEnabled="{Binding StopButtonEnabled}">
                            <ui:SimpleStackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon
                                    Height="20"
                                    Animation="Spin"
                                    Foreground="DarkRed"
                                    Kind="StopwatchStop" />
                                <TextBlock Margin="6,0,0,0" Text="Stop" />
                            </ui:SimpleStackPanel>
                        </Button>

                        <Button
                            Width="120"
                            Height="50"
                            Margin="20,0,0,0"
                            Command="{Binding ClickPlotFormatCommand}">
                            <ui:SimpleStackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon
                                    Height="20"
                                    Animation="Spin"
                                    Foreground="Black"
                                    Kind="SkipBackwardOutline" />
                                <TextBlock Margin="6,0,0,0" Text="Domyślne" />
                            </ui:SimpleStackPanel>
                        </Button>
                        <Button
                            Width="120"
                            Height="50"
                            Margin="20,0,0,0"
                            Command="{Binding ClickOpenFileCommand}"
                            IsEnabled="{Binding StopButtonEnabled, Converter={StaticResource Not}}">
                            <ui:SimpleStackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon
                                    Height="20"
                                    Animation="Spin"
                                    Foreground="Black"
                                    Kind="FileReportOutline" />
                                <TextBlock Margin="6,0,0,0" Text="Wczytaj" />
                            </ui:SimpleStackPanel>
                        </Button>

                        <TextBlock
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Czas cyklu: " />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding CycleDurationText}" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="Start cyklu: " />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding CycleStartText}" />
                    </ui:SimpleStackPanel>

                    <Viewbox
                        Grid.Row="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">
                        <Canvas Width="790" Margin="5,10,5,10">

                            <Image
                                Width="790"
                                HorizontalAlignment="Stretch"
                                Source="/Images/background1.jpeg"
                                Stretch="UniformToFill" />

                            <ui:SimpleStackPanel
                                Canvas.Left="100"
                                Canvas.Top="116"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Orientation="Vertical">
                                <TextBlock Background="LightGray" Text="T1" />
                                <TextBlock Background="WhiteSmoke" Text="{Binding Temperature[0]}" />
                            </ui:SimpleStackPanel>

                            <ui:SimpleStackPanel
                                Canvas.Left="150"
                                Canvas.Top="100"
                                Orientation="Vertical">
                                <TextBlock Background="LightGray" Text="T2" />
                                <TextBlock Background="WhiteSmoke" Text="{Binding Temperature[1]}" />
                            </ui:SimpleStackPanel>

                            <ui:SimpleStackPanel
                                Canvas.Left="200"
                                Canvas.Top="100"
                                Orientation="Vertical">
                                <TextBlock Background="LightGray" Text="T3" />
                                <TextBlock Background="WhiteSmoke" Text="{Binding Temperature[2]}" />
                            </ui:SimpleStackPanel>

                            <ui:SimpleStackPanel
                                Canvas.Left="250"
                                Canvas.Top="100"
                                Orientation="Vertical">
                                <TextBlock Background="LightGray" Text="T4" />
                                <TextBlock Background="WhiteSmoke" Text="{Binding Temperature[3]}" />
                            </ui:SimpleStackPanel>

                            <ui:SimpleStackPanel
                                Canvas.Left="300"
                                Canvas.Top="100"
                                Orientation="Vertical">
                                <TextBlock Background="LightGray" Text="T5" />
                                <TextBlock Background="WhiteSmoke" Text="{Binding Temperature[4]}" />
                            </ui:SimpleStackPanel>

                            <ui:SimpleStackPanel
                                Canvas.Left="350"
                                Canvas.Top="100"
                                Orientation="Vertical">
                                <TextBlock Background="LightGray" Text="T6" />
                                <TextBlock Background="WhiteSmoke" Text="{Binding Temperature[5]}" />
                            </ui:SimpleStackPanel>

                            <ui:SimpleStackPanel
                                Canvas.Left="400"
                                Canvas.Top="100"
                                Orientation="Vertical">
                                <TextBlock Background="LightGray" Text="T7" />
                                <TextBlock Background="WhiteSmoke" Text="{Binding Temperature[6]}" />
                            </ui:SimpleStackPanel>

                            <ui:SimpleStackPanel
                                Canvas.Left="400"
                                Canvas.Top="100"
                                Orientation="Vertical">
                                <TextBlock Background="LightGray" Text="T7" />
                                <TextBlock Background="WhiteSmoke" Text="{Binding Temperature[6]}" />
                            </ui:SimpleStackPanel>

                            <ui:SimpleStackPanel
                                Canvas.Left="400"
                                Canvas.Top="100"
                                Orientation="Vertical">
                                <TextBlock Background="LightGray" Text="T8" />
                                <TextBlock Background="WhiteSmoke" Text="{Binding Temperature[7]}" />
                            </ui:SimpleStackPanel>


                            <ui:SimpleStackPanel
                                Canvas.Left="450"
                                Canvas.Top="100"
                                Orientation="Vertical">
                                <TextBlock Background="LightGray" Text="T9" />
                                <TextBlock Background="WhiteSmoke" Text="{Binding Temperature[8]}" />
                            </ui:SimpleStackPanel>

                            <ui:SimpleStackPanel
                                Canvas.Left="500"
                                Canvas.Top="100"
                                Orientation="Vertical">
                                <TextBlock Background="LightGray" Text="T10" />
                                <TextBlock Background="WhiteSmoke" Text="{Binding Temperature[9]}" />
                            </ui:SimpleStackPanel>

                            <ui:SimpleStackPanel
                                Canvas.Left="550"
                                Canvas.Top="100"
                                Orientation="Vertical">
                                <TextBlock Background="LightGray" Text="T11" />
                                <TextBlock Background="WhiteSmoke" Text="{Binding Temperature[10]}" />
                            </ui:SimpleStackPanel>

                            <ui:SimpleStackPanel
                                Canvas.Left="600"
                                Canvas.Top="100"
                                Orientation="Vertical">
                                <TextBlock Background="LightGray" Text="T12" />
                                <TextBlock Background="WhiteSmoke" Text="{Binding Temperature[11]}" />
                            </ui:SimpleStackPanel>

                            <ui:SimpleStackPanel
                                Canvas.Left="650"
                                Canvas.Top="100"
                                Orientation="Vertical">
                                <TextBlock Background="LightGray" Text="P1" />
                                <TextBlock Background="WhiteSmoke" Text="{Binding Pressure[0]}" />
                            </ui:SimpleStackPanel>

                            <ui:SimpleStackPanel
                                Canvas.Left="700"
                                Canvas.Top="100"
                                Orientation="Vertical">
                                <TextBlock Background="LightGray" Text="P2" />
                                <TextBlock Background="WhiteSmoke" Text="{Binding Pressure[1]}" />
                            </ui:SimpleStackPanel>

                            <ui:SimpleStackPanel
                                Canvas.Left="750"
                                Canvas.Top="100"
                                Orientation="Vertical">
                                <TextBlock Background="LightGray" Text="W" />
                                <TextBlock Background="WhiteSmoke" Text="{Binding WeightText}" />
                            </ui:SimpleStackPanel>

                        </Canvas>
                    </Viewbox>

                    <Grid
                        Grid.Row="1"
                        Margin="25,0,0,5"
                        VerticalAlignment="Bottom">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <!--  Wiersz 1  -->
                            <RowDefinition Height="*" />
                            <!--  Wiersz 2  -->
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            FontWeight="Bold"
                            Text="T1" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="{Binding Temperature[0]}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            FontWeight="Bold"
                            Text="T2" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{Binding Temperature[1]}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            FontWeight="Bold"
                            Text="T3" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="2"
                            Text="{Binding Temperature[2]}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="3"
                            FontWeight="Bold"
                            Text="T4" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="3"
                            Text="{Binding Temperature[3]}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="4"
                            FontWeight="Bold"
                            Text="T5" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="4"
                            Text="{Binding Temperature[4]}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="5"
                            FontWeight="Bold"
                            Text="T6" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="5"
                            Text="{Binding Temperature[5]}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="6"
                            FontWeight="Bold"
                            Text="T7" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="6"
                            Text="{Binding Temperature[6]}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="7"
                            FontWeight="Bold"
                            Text="T8" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="7"
                            Text="{Binding Temperature[7]}" />
                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="8"
                            FontWeight="Bold"
                            Text="T9" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="8"
                            Text="{Binding Temperature[8]}" />

                    </Grid>

                </Grid>



            </TabItem>

            <TabItem Width="130">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon
                            Height="24"
                            Animation="Spin"
                            Foreground="Black"
                            Kind="ChartLine" />
                        <TextBlock Margin="6,0,0,0" Text="Trendy" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>
                    <oxy:PlotView Grid.Row="2" Model="{Binding TemperatureModelCommon}" />
                    <oxy:PlotView Grid.Row="1" Model="{Binding PressureModelCommon}" />
                    <oxy:PlotView Grid.Row="0" Model="{Binding WeightModelCommon}" />
                </Grid>
            </TabItem>

            <TabItem Width="130">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon
                            Height="24"
                            Animation="Spin"
                            Foreground="Black"
                            Kind="ScaleUnbalanced" />
                        <TextBlock Margin="6,0,0,0" Text="Waga" />
                    </StackPanel>
                </TabItem.Header>
                <oxy:PlotView Model="{Binding WeightModel}" />
            </TabItem>

            <TabItem Width="130">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon
                            Height="20"
                            Animation="Spin"
                            Foreground="Black"
                            Kind="Accelerometer" />
                        <TextBlock Margin="6,0,0,0" Text="Ciśnienie" />
                    </StackPanel>
                </TabItem.Header>
                <oxy:PlotView Model="{Binding PressureModel}" />
            </TabItem>

            <TabItem Width="130">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon
                            Height="24"
                            Animation="Spin"
                            Foreground="Black"
                            Kind="WaterThermometerOutline" />
                        <TextBlock Margin="6,0,0,0" Text="Temperatura" />
                    </StackPanel>
                </TabItem.Header>
                <oxy:PlotView Model="{Binding TemperatureModel}" />
            </TabItem>


            <TabItem Width="130">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon
                            Height="24"
                            Animation="Spin"
                            Foreground="Black"
                            Kind="InfoBoxOutline" />
                        <TextBlock Margin="6,0,0,0" Text="Informacje" />
                    </StackPanel>
                </TabItem.Header>
                <ui:SimpleStackPanel
                    Width="800"
                    Margin="20"
                    HorizontalAlignment="Center"
                    Orientation="Vertical">
                    <Image
                        Width="200"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Left"
                        Source="/Images/S7ExpertLogo.png" />
                    <TextBlock
                        Margin="0,20,0,0"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="e-mail: biuro@s7expert.pl" />
                    <TextBlock
                        Margin="0,0,0,0"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="tel. +48 606 631 709" />

                    <TextBlock
                        Margin="0,0,0,0"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="{Binding AssemblyVersion, StringFormat='Wersja: {0}'}" />

                    <TextBlock
                        Margin="0,0,0,0"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="{Binding AssemblyBuildDate, StringFormat='Skompilowano: {0}'}" />

                    <TextBlock Margin="0,20,0,0">
                        <Bold>Instrukcja:</Bold> <LineBreak />
                        Prawy klawisz myszy + ruch : przesuwanie wykresu<LineBreak />
                        Kółko myszy                : skalowanie wykresu<LineBreak />
                        Przycisk "Domyślne"        : przywraca domyślne skalowanie<LineBreak />
                        Przycisk "Wczytaj"         : wczytuje historyczne zapisy<LineBreak />
                    </TextBlock>


                </ui:SimpleStackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>

</Window>

