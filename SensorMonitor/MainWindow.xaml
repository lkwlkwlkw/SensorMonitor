<Window
    x:Class="SensorMonitor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.modernwpf.com/2019"
    xmlns:oxy="http://oxyplot.org/wpf"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    Title="Sensor Monitor"
    Width="1280"
    Height="720"
    ui:WindowHelper.UseModernWindowStyle="True"
    >

    <Window.Resources>
        <Style x:Key="HeaderTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <StatusBar DockPanel.Dock="Bottom" Height="24">
            <StatusBarItem>
                <TextBlock Text="Gotowy"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="Home"  Animation="Spin"  />
                        <TextBlock Text="Start" Margin="6,0,0,0"/>
                    </StackPanel>
                </TabItem.Header>
                <DockPanel>
                    <ui:SimpleStackPanel Margin="12" Spacing="24">
                        <TextBlock Text="My first ModernWPF app" Style="{StaticResource HeaderTextBlockStyle}" />
                        <Button Content="I am a button" />
                        <Button Content="I am an accent button" Style="{StaticResource AccentButtonStyle}" />
                    </ui:SimpleStackPanel>
                </DockPanel>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="Thermometer"  Animation="Spin"  />
                        <TextBlock Text="Temperatura" Margin="6,0,0,0"/>
                    </StackPanel>
                </TabItem.Header>
                <oxy:PlotView Model="{Binding TemperatureModel}"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="Scale"  Animation="Spin"  />
                        <TextBlock Text="Waga" Margin="6,0,0,0"/>
                    </StackPanel>
                </TabItem.Header>
                <oxy:PlotView Model="{Binding WeightModel}"/>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="Water"  Animation="Spin"  />
                        <TextBlock Text="Ciśnienie" Margin="6,0,0,0"/>
                    </StackPanel>
                </TabItem.Header>
                <oxy:PlotView Model="{Binding PressureModel}"/>
            </TabItem>
        </TabControl>
    </DockPanel>

</Window>

